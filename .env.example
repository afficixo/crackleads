DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRY=2592000
MANAGER_USERNAME="manager"
MANAGER_PASSWORD="replace-with-a-unique-strong-password"
# Affmine-style Support messenger (sidebar Support + floating launcher)
NEXT_PUBLIC_INTERCOM_APP_ID="dld8i4fh"
# Required for Affmine-identical logged-in Intercom (HMAC-SHA256 of user_id).
# Without it, Support still works via visitor-mode messenger + same launcher padding.
INTERCOM_IDENTITY_SECRET=""
# Publisher-facing tracking domain (shown in campaign Tracking URL).
# Public links look like: https://tracking.example.com/{publisher_id}/{offer_id}/?s1=&s2=
# Clicks rewrite to the hidden main offer with s1=publisher, s2=offer, s3=sub1, s4=sub2.
TRACKING_DOMAIN="https://tracking.example.com"
NEXT_PUBLIC_TRACKING_DOMAIN="https://tracking.example.com"
